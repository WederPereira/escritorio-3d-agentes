      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const c = $('Conferir envio').first().json, r = $json;\nconst ok = (r.statusCode || 0) >= 200 && (r.statusCode || 0) < 300;\nconst erro = ok ? '' : 'a Evolution recusou (' + (r.statusCode || 'sem resposta') + '): ' + JSON.stringify(r.body || r.error || '').slice(0, 200);\nreturn [{ json: { ok, erro, numero: c.numero, nome: c.nome } }];\n"
      },
