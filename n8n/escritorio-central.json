    {
      "parameters": {
        "jsCode": "const m = $getWorkflowStaticData('global').telas || {};\nconst telas = m.telas || [];\nif (!telas.length) return [{ json: { texto: 'O escritório não contou o que está nas telas (ele está fechado?).' } }];\nconst linhas = telas.map(t => `${t.tela} · ${t.nome}${t.mesa ? ' (mesa de ' + t.mesa + ')' : ''}\\n` + (t.guias || []).map(g =>\n  `   guia ${g.n}${g.ativa ? ' (na frente)' : ''}: ${g.titulo || '(sem título)'} — ${g.url}${g.tocando ? ' · tocando som' : ''}`).join('\\n')\n  + (t.conteudo ? `\\n   conteúdo da guia da frente:\\n   ${t.conteudo.replace(/\\n/g, '\\n   ')}` : ''));\nreturn [{ json: { texto: `Telas do escritório (atualizado ${m.t}):\\n` + linhas.join('\\n') } }];\n"
      },
