      "id": "a8969d42-630a-4766-a89c-c9c07de0d4a4",
      "name": "Comandos recentes",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
